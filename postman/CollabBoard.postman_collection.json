{
  "info": {
    "name": "CollabBoard",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Status code is 2xx', function () {",
          "    pm.response.to.be.success;",
          "});",
          "pm.test('Response has success flag', function () {",
          "    var jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('success');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Ada)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data.token) {",
                  "    pm.environment.set('token', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"ada@collabboard.local\",\"password\":\"CollabBoard!1\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Workspaces",
      "item": [
        {
          "name": "List Workspaces",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workspaces",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspaces"
              ]
            }
          }
        },
        {
          "name": "Get Workspace",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspaces",
                "{{workspaceId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "RBAC",
      "item": [
        {
          "name": "Login (Linus - Developer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data.token) {",
                  "    pm.environment.set('linusToken', json.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"linus@collabboard.local\",\"password\":\"CollabBoard!1\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Developer List Workspaces (Only Assigned)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('Only assigned workspace listed', function () {",
                  "    var ids = json.data.map(function(w) { return w.id; });",
                  "    pm.expect(ids).to.include('ws-website');",
                  "    pm.expect(ids).to.not.include('ws-mobile');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{linusToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workspaces",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspaces"
              ]
            }
          }
        },
        {
          "name": "Developer GET Foreign Workspace (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403 Forbidden', function () { pm.response.to.have.status(403); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.error.code).to.eql('FORBIDDEN');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{linusToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workspaces/ws-mobile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspaces",
                "ws-mobile"
              ]
            }
          }
        },
        {
          "name": "Developer Create Workspace (403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 403 Forbidden', function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{linusToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Unauthorized Project\",\"description\":\"Denied\",\"color\":\"#C6F135\"}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspaces"
              ]
            }
          }
        },
        {
          "name": "SPM List All Workspaces",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "var ids = json.data.map(function(w) { return w.id; });",
                  "pm.expect(ids).to.include('ws-website');",
                  "pm.expect(ids).to.include('ws-mobile');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workspaces",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspaces"
              ]
            }
          }
        },
        {
          "name": "Invite Member with Scoped Visibility",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"userId\":\"u-linus\",\"role\":\"developer\",\"visibleTreeNodeIds\":[\"tn-ios\"]}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/ws-mobile/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspaces",
                "ws-mobile",
                "members"
              ]
            }
          }
        },
        {
          "name": "Update Member Role and Visibility",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"role\":\"developer\",\"visibleTreeNodeIds\":[\"tn-ios\",\"tn-android\"]}"
            },
            "url": {
              "raw": "{{baseUrl}}/workspaces/ws-mobile/members/u-linus",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspaces",
                "ws-mobile",
                "members",
                "u-linus"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tree",
      "item": [
        {
          "name": "List Tree",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/tree",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspaces",
                "{{workspaceId}}",
                "tree"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List Tasks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "workspaces",
                "{{workspaceId}}",
                "tasks"
              ]
            }
          }
        },
        {
          "name": "Get Task",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tasks",
                "{{taskId}}"
              ]
            }
          }
        }
      ]
    }
  ]
}